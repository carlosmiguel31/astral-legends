# Copie para apps/api/.env (cp .env.example .env  |  copy .env.example .env no Windows)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Credenciais do docker-compose de desenvolvimento. Nunca use estas em produção.
DATABASE_URL=postgresql://astral:astral_dev@localhost:5432/astral_dev
REDIS_URL=redis://localhost:6379/0

# Origens liberadas para CORS e WebSocket (separadas por vírgula). Em produção: somente https.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true apenas atrás de um reverse proxy confiável (Caddy/Nginx na VPS).
TRUST_PROXY=false
RATE_LIMIT_MAX=300

# Testes de integração (banco *_test é recriado a cada execução).
TEST_DATABASE_URL=postgresql://astral:astral_dev@localhost:5432/astral_test
TEST_REDIS_URL=redis://localhost:6379/15

# Sessões (token de acesso curto + refresh rotativo em cookies HttpOnly)
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=30
# COOKIE_SECURE=true   # sempre ativo em produção; use em dev atrás de HTTPS

# Proteções de autenticação
REGISTER_LIMIT_PER_HOUR=10
LOGIN_LIMIT_PER_15MIN=30
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=30
LOGIN_LOCKOUT_MINUTES=15

# Jogo
INVENTORY_CAPACITY=100
