// Modelo de dados preliminar do Astral Legends.
// Convenções:
// - Tabelas e colunas em snake_case (@@map/@map); modelos em PascalCase.
// - Valores monetários e de recursos são BigInt (nunca ponto flutuante).
// - Enums de gameplay usam os mesmos ids de @astral/game-core.
// - Restrições que o Prisma não modela (CHECK, triggers de append-only) ficam
//   no SQL da migração; veja docs/DATA_MODEL.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Contas e sessões ─────────────────────────────

enum AccountRole {
  PLAYER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model Account {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// Nome de usuário público, como digitado (3–16: letras, números e _).
  username     String        @db.VarChar(16)
  /// Nome de usuário em minúsculas, para unicidade sem diferenciar maiúsculas.
  usernameKey  String        @unique @map("username_key") @db.VarChar(16)
  /// E-mail normalizado (minúsculas, sem espaços).
  email        String        @unique @db.VarChar(254)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  role         AccountRole   @default(PLAYER)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      AuthSession[]
  character     Character?
  balances      WalletBalance[]
  ledgerEntries LedgerEntry[]

  @@map("accounts")
}

model AuthSession {
  id                       String    @id @default(uuid(7)) @db.Uuid
  accountId                String    @map("account_id") @db.Uuid
  /// SHA-256 do token de acesso (curta duração). Tokens em claro nunca são persistidos.
  accessTokenHash          String    @unique @map("access_token_hash") @db.VarChar(64)
  accessExpiresAt          DateTime  @map("access_expires_at") @db.Timestamptz(3)
  /// SHA-256 do refresh token atual (rotacionado a cada uso).
  refreshTokenHash         String    @unique @map("refresh_token_hash") @db.VarChar(64)
  /// Refresh token anterior: se reaparecer, houve roubo e a sessão é revogada.
  previousRefreshTokenHash String?   @map("previous_refresh_token_hash") @db.VarChar(64)
  userAgent                String?   @map("user_agent") @db.VarChar(512)
  ip                       String?   @db.VarChar(64)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt               DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Última rotação: dá uma janela curta de tolerância a refresh simultâneo em várias abas.
  refreshedAt              DateTime? @map("refreshed_at") @db.Timestamptz(3)
  /// Expiração absoluta da sessão (refresh).
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason            String?   @map("revoked_reason") @db.VarChar(32)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([previousRefreshTokenHash])
  @@map("auth_sessions")
}

// ───────────────────────────── Personagens ─────────────────────────────

enum CharacterClass {
  guardian
  arcanist
  blade
}

enum Affinity {
  solar
  lunar
  storm
  abyssal
}

model Character {
  id         String         @id @default(uuid(7)) @db.Uuid
  /// Único: um personagem por conta no MVP (garantido também contra corridas).
  accountId  String         @unique @map("account_id") @db.Uuid
  name       String         @db.VarChar(24)
  /// Nome normalizado para unicidade sem diferenciar maiúsculas/acentos.
  nameKey    String         @unique @map("name_key") @db.VarChar(24)
  classId    CharacterClass @map("class_id")
  affinity   Affinity
  /// Aparência inicial (índices de paletas), validada pelo servidor.
  appearance Json
  level      Int            @default(1)
  /// XP acumulada dentro do nível atual.
  xp         Int            @default(0)
  /// Versão para controle de concorrência otimista.
  version    Int            @default(1)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  account     Account          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  items       ItemInstance[]
  hunt        HuntSession?
  settlements HuntSettlement[]
  regions     RegionProgress[]
  waveClears  WaveClear[]
  commands    HuntCommand[]

  @@map("characters")
}

// ───────────────────────────── Economia ─────────────────────────────

enum Currency {
  GOLD
  ESSENCE
  DIAMOND
}

enum LedgerReason {
  HUNT_REWARD
  BOSS_REWARD
  ITEM_UPGRADE
  NPC_SALE
  MARKET_ESCROW_LOCK
  MARKET_ESCROW_RELEASE
  MARKET_FEE
  ADMIN_GRANT
  ADMIN_REVOKE
  DEV_SEED
  WAVE_FIRST_CLEAR
}

/// Saldo atual (projeção do livro-razão). Alterado somente pelo serviço de ledger.
model WalletBalance {
  accountId String   @map("account_id") @db.Uuid
  currency  Currency
  amount    BigInt   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@id([accountId, currency])
  @@map("wallet_balances")
}

/// Livro-razão imutável (append-only, garantido por trigger).
model LedgerEntry {
  id             BigInt       @id @default(autoincrement())
  accountId      String       @map("account_id") @db.Uuid
  currency       Currency
  delta          BigInt
  balanceAfter   BigInt       @map("balance_after")
  reason         LedgerReason
  idempotencyKey String       @unique @map("idempotency_key") @db.VarChar(128)
  refType        String?      @map("ref_type") @db.VarChar(64)
  refId          String?      @map("ref_id") @db.VarChar(128)
  metadata       Json?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, currency, createdAt])
  @@index([refType, refId])
  @@map("ledger_entries")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

/// Idempotência de operações compostas (ex.: aprimorar item = débito + mutação do item).
model IdempotencyRecord {
  key         String            @id @db.VarChar(128)
  accountId   String            @map("account_id") @db.Uuid
  operation   String            @db.VarChar(64)
  /// Hash do corpo da requisição: mesma chave com corpo diferente é conflito.
  requestHash String            @map("request_hash") @db.VarChar(128)
  status      IdempotencyStatus @default(IN_PROGRESS)
  response    Json?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_records")
}

// ───────────────────────────── Itens ─────────────────────────────

enum EquipSlot {
  weapon
  head
  chest
  hands
  legs
  feet
}

enum Rarity {
  common
  uncommon
  rare
  epic
  legendary
  astral
}

enum ItemSource {
  DROP
  CRAFT
  QUEST
  ADMIN
  WAVE_REWARD
}

/// Instância única de item. A definição estática (nome, slot, visual) vive em game-core (defId).
model ItemInstance {
  id               String     @id @default(uuid(7)) @db.Uuid
  ownerCharacterId String     @map("owner_character_id") @db.Uuid
  defId            String     @map("def_id") @db.VarChar(64)
  rarity           Rarity
  upgradeLevel     Int        @default(0) @map("upgrade_level")
  /// Bônus sorteados na criação (ItemBonuses de game-core), imutáveis.
  bonuses          Json
  /// Versão das regras usada para gerar o item.
  rulesetVersion   Int        @map("ruleset_version")
  /// Nulo = no inventário. Único por personagem e slot.
  equippedSlot     EquipSlot? @map("equipped_slot")
  tradable         Boolean    @default(true)
  source           ItemSource
  /// Origem única (ex.: `hunt:<runId>:enc:<n>`): impede criar o mesmo item duas vezes.
  sourceRef        String?    @unique @map("source_ref") @db.VarChar(128)
  version          Int        @default(1)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Character @relation(fields: [ownerCharacterId], references: [id], onDelete: Restrict)

  @@unique([ownerCharacterId, equippedSlot])
  @@index([ownerCharacterId])
  @@map("item_instances")
}

// ───────────────────────────── Caça idle ─────────────────────────────

enum HuntStatus {
  ACTIVE
  STOPPED
}

/// Estado da caça automática. O servidor liquida o tempo decorrido sob demanda,
/// de forma determinística a partir de `seed` e `encountersResolved`.
model HuntSession {
  id                 String     @id @default(uuid(7)) @db.Uuid
  characterId        String     @unique @map("character_id") @db.Uuid
  /// Identifica cada caçada iniciada; compõe as chaves de idempotência das recompensas.
  runId              String     @map("run_id") @db.Uuid
  regionId           String     @map("region_id") @db.VarChar(64)
  /// Semente uint32 (armazenada em bigint para caber em 0..2^32-1).
  seed               BigInt
  rulesetVersion     Int        @map("ruleset_version")
  status             HuntStatus @default(ACTIVE)
  startedAt          DateTime   @map("started_at") @db.Timestamptz(3)
  lastSettledAt      DateTime   @map("last_settled_at") @db.Timestamptz(3)
  encountersResolved Int        @default(0) @map("encounters_resolved")
  version            Int        @default(1)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("hunt_sessions")
}

/// Resumo imutável de cada liquidação. A unicidade (run, primeiro encontro) impede
/// que a mesma janela de caça seja liquidada duas vezes.
model HuntSettlement {
  id             BigInt   @id @default(autoincrement())
  characterId    String   @map("character_id") @db.Uuid
  runId          String   @map("run_id") @db.Uuid
  regionId       String   @map("region_id") @db.VarChar(64)
  fromEncounter  Int      @map("from_encounter")
  toEncounter    Int      @map("to_encounter")
  windowStart    DateTime @map("window_start") @db.Timestamptz(3)
  windowEnd      DateTime @map("window_end") @db.Timestamptz(3)
  forfeitedMs    BigInt   @default(0) @map("forfeited_ms")
  wins           Int
  losses         Int
  timeouts       Int
  xpGained       Int      @map("xp_gained")
  gold           BigInt
  essence        BigInt
  itemsDropped   Int      @map("items_dropped")
  itemsDiscarded Int      @map("items_discarded")
  levelBefore    Int      @map("level_before")
  levelAfter     Int      @map("level_after")
  /// Últimos encontros (resumo) para o histórico de combate.
  recent         Json
  rulesetVersion Int      @map("ruleset_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Fase 2A — waves (nulos em liquidações anteriores às waves).
  waveBefore        Int?      @map("wave_before")
  waveAfter         Int?      @map("wave_after")
  modeAfter         HuntMode? @map("mode_after")
  wavesCleared      Int       @default(0) @map("waves_cleared")
  firstClears       Int       @default(0) @map("first_clears")
  firstClearGold    BigInt    @default(0) @map("first_clear_gold")
  firstClearEssence BigInt    @default(0) @map("first_clear_essence")
  /// Conclusões e recuos ocorridos nesta liquidação (resumo).
  waveEvents        Json      @default("[]") @map("wave_events")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([runId, fromEncounter])
  @@index([characterId, createdAt])
  @@map("hunt_settlements")
}

// ───────────────────────────── Waves (Fase 2A) ─────────────────────────────

enum HuntMode {
  ADVANCE
  FARM
}

/// Progresso de waves de um personagem em uma região. Independente por região:
/// trocar de região e voltar retoma a wave, o modo e as vitórias já obtidas.
model RegionProgress {
  characterId    String   @map("character_id") @db.Uuid
  regionId       String   @map("region_id") @db.VarChar(64)
  mode           HuntMode @default(ADVANCE)
  wave           Int      @default(1)
  /// Vitórias na tentativa atual da wave (0 .. vitórias por wave − 1).
  waveWins       Int      @default(0) @map("wave_wins")
  waveLosses     Int      @default(0) @map("wave_losses")
  failStreak     Int      @default(0) @map("fail_streak")
  /// Recompensas acumuladas na tentativa atual (resumo exibido na conclusão).
  waveXp         Int      @default(0) @map("wave_xp")
  waveGold       BigInt   @default(0) @map("wave_gold")
  waveEssence    BigInt   @default(0) @map("wave_essence")
  waveItems      Int      @default(0) @map("wave_items")
  /// Maior wave já concluída (0 = nenhuma). Só cresce.
  highestCleared Int      @default(0) @map("highest_cleared")
  totalClears    Int      @default(0) @map("total_clears")
  /// Aviso de mudança automática (recuo, limite de conteúdo, nível insuficiente).
  notice         Json?
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([characterId, regionId])
  @@map("region_progress")
}

/// Registro imutável de cada conclusão de wave. `(run_id, encounter_index)` é único
/// (a mesma conclusão não pode ser registrada duas vezes) e um índice parcial garante
/// uma única primeira conclusão por personagem, região e wave.
model WaveClear {
  id                BigInt   @id @default(autoincrement())
  characterId       String   @map("character_id") @db.Uuid
  regionId          String   @map("region_id") @db.VarChar(64)
  runId             String   @map("run_id") @db.Uuid
  wave              Int
  kind              String   @db.VarChar(8)
  mode              HuntMode
  encounterIndex    Int      @map("encounter_index")
  firstClear        Boolean  @map("first_clear")
  wins              Int
  losses            Int
  xp                Int
  gold              BigInt
  essence           BigInt
  items             Int
  firstClearGold    BigInt   @default(0) @map("first_clear_gold")
  firstClearEssence BigInt   @default(0) @map("first_clear_essence")
  firstClearItemDef String?  @map("first_clear_item_def") @db.VarChar(64)
  firstClearRarity  Rarity?  @map("first_clear_rarity")
  nextMode          HuntMode @map("next_mode")
  nextWave          Int      @map("next_wave")
  nextReason        String   @map("next_reason") @db.VarChar(16)
  clearedAt         DateTime @map("cleared_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([runId, encounterIndex])
  @@index([characterId, regionId, clearedAt])
  @@map("wave_clears")
}

/// Comandos do jogador sobre a caçada (auditoria e reprodução). Imutável.
/// `at_encounter` + `applied_at` formam a fronteira lógica e temporal do comando.
model HuntCommand {
  id          BigInt   @id @default(autoincrement())
  characterId String   @map("character_id") @db.Uuid
  regionId    String   @map("region_id") @db.VarChar(64)
  runId       String?  @map("run_id") @db.Uuid
  command     String   @db.VarChar(16)
  atEncounter Int?     @map("at_encounter")
  fromState   Json?    @map("from_state")
  toState     Json     @map("to_state")
  appliedAt   DateTime @map("applied_at") @db.Timestamptz(3)
  requestId   String?  @map("request_id") @db.VarChar(64)

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, appliedAt])
  @@map("hunt_commands")
}

// ───────────────────────────── Auditoria ─────────────────────────────

/// Trilha de auditoria imutável (append-only, garantido por trigger).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorType  String   @map("actor_type") @db.VarChar(32)
  actorId    String?  @map("actor_id") @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(64)
  targetId   String?  @map("target_id") @db.VarChar(128)
  payload    Json?
  ip         String?  @db.VarChar(64)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}
